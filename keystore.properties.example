# Plantilla de la clave de firma. Copia este fichero como keystore.properties
# y rellena los datos de tu clave.
#
# La clave se genera una sola vez con:
#   keytool -genkeypair -v -keystore keystore/notas-release.jks -storetype PKCS12 \
#           -alias notas -keyalg RSA -keysize 2048 -validity 10000 \
#           -storepass TU_CONTRASEÑA -keypass TU_CONTRASEÑA \
#           -dname "CN=Notas, OU=Personal, O=Notas, C=ES"
#
# keystore.properties y los .jks estan en .gitignore: no se suben a Git.
# Guardalos en un sitio seguro: sin ellos no se puede actualizar la app firmada.
storeFile=keystore/notas-release.jks
storePassword=TU_CONTRASEÑA
keyAlias=notas
keyPassword=TU_CONTRASEÑA
